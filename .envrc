# direnv: 进入本工程自动激活 ESP-IDF v5.5.2 环境
#
# 依赖:
#   brew install direnv
#   并在 ~/.zshrc 末尾加:  eval "$(direnv hook zsh)"
#
# 原理:
#   - 进目录自动 source IDF 的 export.sh(只在本 shell 子进程生效,不污染全局)
#   - 离开目录自动清理环境变量
#   - 改本文件需 direnv allow 一次

# ESP-IDF 版本(与本工程 idf_component.yml 要求 >=5.5.2 对齐)
IDF_VERSION="v5.5.2"
IDF_PATH="${HOME}/esp/esp-idf-${IDF_VERSION}"
export IDF_PATH

# 工具链与 venv 都隔离在 ~/.espressif 下,不进工程目录
export IDF_TOOLS_PATH="${HOME}/.espressif"

# IDF 不存在时给出清晰指引,而不是静默失败
if [ ! -f "${IDF_PATH}/export.sh" ]; then
    log_error "ESP-IDF ${IDF_VERSION} 未安装于 ${IDF_PATH}"
    log_error "请先运行: scripts/bootstrap.sh"
fi

# 实际激活:source IDF 自带的 export.sh
# 它会设置 PATH(virtualenv + xtensa 工具链)及其它 IDF 变量
source "${IDF_PATH}/export.sh" >/dev/null 2>&1 || {
    log_error "激活 ESP-IDF 失败,请运行 scripts/bootstrap.sh 检查依赖"
}

# 工程内便捷别名
export RIG_BOARD="${RIG_BOARD:-hover}"   # 默认板型,可覆盖: RIG_BOARD=puppy

# ===== Tailscale PoC 凭证(不进 git)=====
# 从 home 目录的 ~/.tailscale-env 加载,编译时注入 PoC 固件
# 文件格式见 poc/secrets.env.example
if [ -f "${HOME}/.tailscale-env" ]; then
    source "${HOME}/.tailscale-env"
fi
