# Tailscale PoC 凭证模板
#
# 复制到 ~/.tailscale-env(注意:是 home 目录,不是工程目录),填入真实值
#   cp poc/secrets.env.example ~/.tailscale-env
#
# 此文件是模板,可进 git;真实凭证文件 ~/.tailscale-env 不进 git
# 被 .envrc source,编译时由 poc/CMakeLists.txt 注入固件

# Tailscale auth key(去 login.tailscale.com/admin/settings/keys 生成)
# 推荐 reusable + ephemeral 类型,PoC 反复烧录不每次生成
# 格式: tskey-auth-XXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
export TS_AUTH_KEY="tskey-auth-REPLACE_ME"

# WiFi 凭证(ESP32 要先连 WiFi 才能跑 Tailscale)
export TS_WIFI_SSID="YOUR_WIFI_SSID"
export TS_WIFI_PASS="YOUR_WIFI_PASSWORD"

# 要访问的内网 AI 服务(Tailscale 内网可达)
# 这里填的是 OpenAI 兼容的 Qwen API 示例
export TS_QWEN_HOST="100.x.x.x"          # tailnet 内 AI 服务的 100.x IP
export TS_QWEN_PORT="8000"               # 服务端口
export TS_QWEN_MODEL="Qwen/Qwen3.5-397B-A17B-FP8"
